<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:IntuitiveMedia.ViewModels"
             x:DataType="vm:MediaDrawerModel"
             x:Class="IntuitiveMedia.Views.MediaDrawer"
             >

      <!-- TODO: Dentro deste Menu, deve haver uma fila de componentes/vídeos. Devem responder ao data-binding do contexto de MediaDrawerModel, e isto deve refletir também em outro controle, que é o PlayerView, que deve responder a este mesmo contexto -->
      <Menu Name="VideoDrawer"
            Width="300" Height="80"
            Background="LightGray"
            Margin="0 50"
            ></Menu>

</UserControl>