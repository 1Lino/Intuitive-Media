<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IntuitiveMedia.ViewModels"
             xmlns:m="using:IntuitiveMedia.Models"
             x:DataType="vm:PlayerViewModel"
             x:Class="IntuitiveMedia.Views.PlaylistDrawer">

    <UserControl.Styles>

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Painel de estilos e suas classes -->
        <Style Selector="Border.item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.item.dragging">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Border.item.current">
            <Setter Property="BorderBrush" Value="#FFFFA640" />
            <Setter Property="Background" Value="#83332311" />
        </Style>

        <Style Selector="Border.item.selected">
            <Setter Property="BorderBrush" Value="#FFFF8800" />
            <Setter Property="Background" Value="#5A2F12" />
        </Style>

        <Style Selector="Border.item.dragover">
            <Setter Property="BorderBrush" Value="#FF7B00" />
            <Setter Property="Background" Value="#472600" />
        </Style>

        <!-- LOAD PLAYLIST -->
        <Style Selector="Button.btn-loadPlaylist PathIcon">
            <Setter Property="Data" Value="M6 3a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3zM4 6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm6.5.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 1 0 1 0v-3h3a.5.5 0 1 0 0-1h-3z" />
        </Style>
        <Style Selector="Button.btn-loadPlaylist:pointerover PathIcon">
            <Setter Property="Data" Value="M3 6a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zm7.5.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 1 0 1 0v-3h3a.5.5 0 1 0 0-1h-3z" />
        </Style>
        <Style Selector="Button.btn-loadPlaylist /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- ADD PLAYLIST -->
        <Style Selector="Button.btn-addPlaylist PathIcon">
            <Setter Property="Data" Value="M6 10a.5.5 0 0 1 .5-.5h3v-3a.5.5 0 0 1 1 0v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3A.5.5 0 0 1 6 10m4 8a8 8 0 1 0 0-16a8 8 0 0 0 0 16m0-1a7 7 0 1 1 0-14a7 7 0 0 1 0 14" />
        </Style>
        <Style Selector="Button.btn-addPlaylist:pointerover PathIcon">
            <Setter Property="Data" Value="M18 10a8 8 0 1 1-16 0a8 8 0 0 1 16 0M6 10a.5.5 0 0 0 .5.5h3v3a.5.5 0 0 0 1 0v-3h3a.5.5 0 0 0 0-1h-3v-3a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0-.5.5" />
        </Style>
        <Style Selector="Button.btn-addPlaylist /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- DELETE PLAYLIST -->
        <Style Selector="Button.btn-deletePlaylist PathIcon">
            <Setter Property="Data" Value="M6 10a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 6 10m4 8a8 8 0 1 0 0-16a8 8 0 0 0 0 16m0-1a7 7 0 1 1 0-14a7 7 0 0 1 0 14" />
        </Style>
        <Style Selector="Button.btn-deletePlaylist:pointerover PathIcon">
            <Setter Property="Data" Value="M18 10a8 8 0 1 1-16 0a8 8 0 0 1 16 0M6 10a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 0-1h-7a.5.5 0 0 0-.5.5" />
        </Style>
        <Style Selector="Button.btn-deletePlaylist /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>


    <!-- Painel principal -->
    <!-- TODO: deve haver uma lógica que faz os demais paineis de controles do player sumirem quando este aqui estiver ativo, e vice versa. Também devo fazer com que as dimensões destes painéis sejam dinâmicos de acordo com o estado da tela (se fullscreen está on ou off) -->
    <Border CornerRadius="10"
            Background="#7CE2E2E2"
            Width="{Binding PlaylistDrawerWidth}" Height="{Binding PlaylistDrawerHeight}" MaxHeight="480"
            Margin="0 50">
        <!--Background:#7CFF2600-->

        <DockPanel Name="PlaylistsDrawer" LastChildFill="False">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Height="{Binding PLaylistScrollHeight}"
                          MaxHeight="400"
                          VerticalAlignment="Top"
                          DockPanel.Dock="Top">

                <ItemsControl x:Name="PlaylistList" ItemsSource="{Binding Playlists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:PlaylistItem">
                            <!-- Margin/Padding orientation: Left, Top, Right, Bottom -->
                            <Border Classes="item" Margin="10 10 20 10 " Padding="4"
                                    Classes.current="{Binding IsCurrent}"
                                    Classes.selected="{Binding IsSelected}"
                                    Cursor="Hand"
                                    DragDrop.AllowDrop="True"
                                    PointerPressed="Item_PointerPressed"
                                    PointerMoved="Item_PointerMoved"
                                    PointerReleased="Item_PointerReleased"
                                    DragDrop.DragOver="Item_DragOver"
                                    DragDrop.DragLeave="Item_DragLeave"
                                    DragDrop.Drop="Item_Drop">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" />
                                    <Border Width="100" Height="60"
                                            Background="Gray" CornerRadius="4"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <Button Content="▶"
                                                    Width="36" Height="36"
                                                    Padding="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#B3000000"
                                                    Foreground="White"
                                                    BorderBrush="Transparent"
                                                    ToolTip.Tip="Reproduzir playlist"
                                                    Click="PlayPlaylist" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>

            <!-- Painel de add e delete-->
            <Border DockPanel.Dock="Bottom"
                    Background="#4B4A4A"
                    Width="160"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="10"
                    CornerRadius="5">
                <!--Background: #BD5712-->
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            Margin="10">

                    <Button Classes="btn-loadPlaylist" Click="LoadPlaylist">
                        <PathIcon />
                    </Button>
                    <Button Classes="btn-addPlaylist" Click="AddPlaylist">
                        <PathIcon />
                    </Button>
                    <Button Classes="btn-deletePlaylist" Click="DeletePlaylist">
                        <PathIcon />
                    </Button>
                </StackPanel>
            </Border>

        </DockPanel>
    </Border>
</UserControl>