<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:IntuitiveMedia.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="IntuitiveMedia.Views.PlayerMediaMenu"
             d:DesignWidth="600" d:DesignHeight="450"
             > <!-- Aponta para o namespace e sua respectiva classe PlayerView-->

             <!-- Listamento horizontal dos controles de mídia. Talvez Grid nem seja necessário-->
             <Grid
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,25"
                 PointerEntered="OnMouseOver"
                 PointerExited="OnMouseExit">

                 <Button Name="BtnVideos"
                         Content="Videos"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Center"
                         Margin="10"
                         ></Button>

             </Grid>
    <!--END-->
</UserControl>