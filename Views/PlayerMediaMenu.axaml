<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:IntuitiveMedia.ViewModels"
             xmlns:control="using:IntuitiveMedia.Views"
             x:DataType="vm:PlayerViewModel"
             x:Class="IntuitiveMedia.Views.PlayerMediaMenu"
             d:DesignWidth="600" d:DesignHeight="450"
             >

    <Grid
        VerticalAlignment="Top"
        HorizontalAlignment="Center"
        Margin="0,0,0,25"
        PointerEntered="OnMouseOver"
        PointerExited="OnMouseExit">

        <Button Name="ToggleVideoDrawerBtn"
                Content="Videos"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="10"
                Click="ToggleDrawerVisibility"></Button>

        <!-- Ao clicar no botão acima, a propriedade IsVideoDrawerOn mudará entre True e False, fazendo a visibilidade do controle abaixo responder conforme este dado através de Data-Binding no contexto de MainViewModel-->
        <control:MediaDrawer IsVisible="{Binding IsVideoDrawerOn}"/>

    </Grid>
    <!--END-->
</UserControl>