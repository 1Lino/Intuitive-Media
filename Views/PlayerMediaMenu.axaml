<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:IntuitiveMedia.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="IntuitiveMedia.Views.PlayerMediaMenu"
             d:DesignWidth="600" d:DesignHeight="450"
             >

    <Grid
        VerticalAlignment="Top"
        HorizontalAlignment="Center"
        Margin="0,0,0,25"
        PointerEntered="OnMouseOver"
        PointerExited="OnMouseExit">

        <Button Name="ToggleVideoDrawerBtn"
                Content="Videos"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="10"
                Click="ToggleDrawerVisibility"></Button>

        <!-- TODO: esse VideoDrawer deve ser um componente separado com seu próprio Data-Context -->
        <Menu Name="VideoDrawer"
              IsVisible="{Binding IsVideoDrawerOn}"
              Width="300" Height="80"
              Background="LightGray"
              Margin="0 50"
              ></Menu>

    </Grid>
    <!--END-->
</UserControl>