<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:IntuitiveMedia.ViewModels"
             xmlns:control="using:IntuitiveMedia.Views"
             x:DataType="vm:PlayerViewModel"
             x:Class="IntuitiveMedia.Views.PlaylistMenu"
             d:DesignWidth="600" d:DesignHeight="450"
             >

    <Grid
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        Margin="0,0,0,25"
        PointerEntered="OnMouseOver"
        PointerExited="OnMouseExit">

        <Button Name="ToggleVideoDrawerBtn"
                Content="Playlists"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="10"
                Click="TogglePlaylistDrawerVisibility"></Button>

        <control:PlaylistDrawer IsVisible="{Binding IsPlaylistDrawerOn}"/>

    </Grid>
    <!--END-->
</UserControl>