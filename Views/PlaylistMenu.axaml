<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:IntuitiveMedia.ViewModels"
             xmlns:control="using:IntuitiveMedia.Views"
             x:DataType="vm:PlayerViewModel"
             x:Class="IntuitiveMedia.Views.PlaylistMenu"
             d:DesignWidth="600" d:DesignHeight="450"
             >

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.btn-playlists PathIcon">
            <Setter Property="Data" Value="M17.09 5.018a.75.75 0 0 1 .91.732V15a2 2 0 1 1-1-1.73V8.61l-6 2.142V16a2 2 0 1 1-1-1.73v-6.2c0-.316.2-.6.498-.706l6.5-2.321zM9 15a1 1 0 1 0 0 2a1 1 0 0 0 0-2m7-1a1 1 0 1 0 0 2a1 1 0 0 0 0-2M11.5 2A2.5 2.5 0 0 1 14 4.5v.553l-1 .356V4.5A1.5 1.5 0 0 0 11.5 3h-7A1.5 1.5 0 0 0 3 4.5v6A1.5 1.5 0 0 0 4.5 12H9v1H4.5A2.5 2.5 0 0 1 2 10.5v-6A2.5 2.5 0 0 1 4.5 2zm-7 7.5a.5.5 0 0 1 .5.5v.5a.5.5 0 0 1-1 0V10a.5.5 0 0 1 .5-.5M11 8.247V9.69l6-2.142V6.104zM4.5 6.75a.5.5 0 0 1 .5.5v.5a.5.5 0 0 1-1 0v-.5a.5.5 0 0 1 .5-.5M4.5 4a.5.5 0 0 1 .5.5V5a.5.5 0 0 1-1 0v-.5a.5.5 0 0 1 .5-.5m7 0a.5.5 0 0 1 .5.5V5a.5.5 0 0 1-1 0v-.5a.5.5 0 0 1 .5-.5" />
        </Style>
        <Style Selector="Button.btn-playlists:pointerover PathIcon">
            <Setter Property="Data" Value="M17.09 5.018a.75.75 0 0 1 .91.732V15a2 2 0 1 1-1-1.73V8.61l-6 2.142V16a2 2 0 1 1-1-1.73v-6.2c0-.316.2-.6.498-.706l6.5-2.321zM11.5 2A2.5 2.5 0 0 1 14 4.5v.553l-3.839 1.37A1.75 1.75 0 0 0 9 8.072V13H4.5A2.5 2.5 0 0 1 2 10.5v-6A2.5 2.5 0 0 1 4.5 2zm-7 7.5a.5.5 0 0 0-.5.5v.5a.5.5 0 0 0 1 0V10a.5.5 0 0 0-.5-.5m0-2.75a.5.5 0 0 0-.5.5v.5a.5.5 0 0 0 1 0v-.5a.5.5 0 0 0-.5-.5M4.5 4a.5.5 0 0 0-.5.5V5a.5.5 0 0 0 1 0v-.5a.5.5 0 0 0-.5-.5m7 0a.5.5 0 0 0-.5.5V5a.5.5 0 0 0 1 0v-.5a.5.5 0 0 0-.5-.5" />
        </Style>
        <Style Selector="Button.btn-playlists /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        Margin="0,0,0,25"
        PointerEntered="OnMouseOver"
        PointerExited="OnMouseExit">

        <Button  Classes="btn-playlists"
                 Name="ToggleVideoDrawerBtn"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Right"
                 Margin="10"
                 Click="TogglePlaylistDrawerVisibility">
            <PathIcon />
        </Button>

        <control:PlaylistDrawer IsVisible="{Binding IsPlaylistDrawerOn, FallbackValue=False}"/>

    </Grid>
    <!--END-->
</UserControl>